    "node": "^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "@angular/common": "21.2.24",
    "@angular/compiler": "21.2.24",
    "@angular/core": "21.2.24",
    "@angular/forms": "21.2.24",
    "@angular/platform-browser": "21.2.24",
    "@angular/router": "21.2.24",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/ios": "8.5.2",
    "@capacitor/share": "8.0.3",
    "@revenuecat/purchases-capacitor": "13.7.0",
