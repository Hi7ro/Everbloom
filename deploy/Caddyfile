{
	email {$EVERBLOOM_ACME_EMAIL}
}

{$EVERBLOOM_DOMAIN} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
	}
	# Never turn API failures into successful HTML navigation responses.
	@api path /api /api/*
	handle @api {
		request_body {
			max_size 32KB
		}
		header Cache-Control no-store
		reverse_proxy backend:8080 {
			header_up X-Real-IP {remote_host}
		}
	}
	handle /runtime-config.json {
		root * /srv
		header Cache-Control no-store
		file_server
	}
	@assets path /art/* /media/* *.js *.css *.woff2 *.ico *.webp *.png *.svg
	handle @assets {
		root * /srv
		@hashed path_regexp hashed ^/(main|polyfills|styles|chunk)-[A-Za-z0-9]+\.(js|css)$
		# Preserve this order: the specific immutable policy overrides the default.
		# Without route, Caddy sorts the matched header first and the default wins.
		route {
			header Cache-Control "public, max-age=3600"
			header @hashed Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
	}
	handle {
		root * /srv
		header Cache-Control no-store
		try_files {path} /index.html
		file_server
	}
}

# Container-local liveness only; this port is not published by Compose.
http://:8081 {
	respond /healthz "ok" 200
}
