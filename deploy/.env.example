# Copy to deploy/.env, replace EVERY placeholder, then chmod 600 deploy/.env.
# Public hostname only: no https:// prefix and no path.
EVERBLOOM_DOMAIN=beta.example.com
EVERBLOOM_PUBLIC_BASE_URL=https://beta.example.com
EVERBLOOM_ACME_EMAIL=operator@example.com
# Change both together if this Docker subnet overlaps an existing network.
EVERBLOOM_EDGE_SUBNET=172.30.73.0/24
EVERBLOOM_CADDY_INTERNAL_IP=172.30.73.2

# Use different randomly generated passwords. No database port is published.
EVERBLOOM_POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
EVERBLOOM_DB_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_APP_PASSWORD

# SMTP provider supporting authenticated STARTTLS (port 587).
EVERBLOOM_SMTP_HOST=smtp.example.com
EVERBLOOM_SMTP_PORT=587
EVERBLOOM_SMTP_USER=REPLACE_WITH_SMTP_USERNAME
EVERBLOOM_SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
EVERBLOOM_MAIL_FROM=Herovera <noreply@example.com>

# Build tags for this release; no secrets are embedded in either image.
EVERBLOOM_RELEASE=local-beta

# Keep preview until stores, operator/legal details and device purchase tests are complete.
# Live validates these keys at startup; NEVER place secret keys in frontend runtime-config.json.
EVERBLOOM_BILLING_MODE=preview
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_APPLE_API_KEY=
REVENUECAT_GOOGLE_API_KEY=
REVENUECAT_ENTITLEMENT_ID=everbloom_plus
REVENUECAT_APPLE_PRODUCT_ID=everbloom_plus_monthly
REVENUECAT_GOOGLE_PRODUCT_ID=everbloom_plus:monthly
REVENUECAT_OFFERING_ID=default
# true only in a separate staging environment for Store sandbox testers.
REVENUECAT_ALLOW_SANDBOX=false
